<rml>
<head>
    <title>Message box</title>
    <link type="text/rcss" href="../Styles/theme.rcss"/>
    <link type="text/rcss" href="../Styles/components.rcss"/>
    <link type="text/rcss" href="../Styles/message-box.rcss"/>
</head>
<body id="message-box" class="overlay" data-model="app" data-event-keydown="messageBoxKey()">
    <div class="message-box-scrim"></div>
    <div class="panel message-box" data-class-info="messageBox.level == 'info'" data-class-warning="messageBox.level == 'warning'" data-class-error="messageBox.level == 'error'">
        <div class="panel-header">
            <svg class="icon-14" data-attr-src="'../Icons/icon-' + messageBox.icon + '.svg'"/>
            <span class="panel-title">{{ messageBox.level }}</span>
        </div>
        <div class="message-box-body">
            <p class="title-card">{{ messageBox.title }}</p>
            <p class="small text-secondary">{{ messageBox.text }}</p>
        </div>
        <div class="message-box-actions">
            <button class="button" autofocus data-event-click="closeMessageBox()"><svg class="icon-16" src="../Icons/icon-check.svg"/><span>OK</span></button>
        </div>
    </div>
</body>
</rml>
