body {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

img, svg {
    flex: 0 0 auto;
}

/*! RmlUi gives an unstyled scrollbar no width. */
scrollbarvertical {
    width: 8dp;
}

scrollbarvertical sliderbar {
    min-height: 24dp;
}

.title-bar {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    height: 36dp;
    padding-left: 16dp;
}

.window-drag-region {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.title-left {
    flex: 1 1 0;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 12dp;
    pointer-events: none;
}

.wordmark, .breadcrumb {
    flex: 0 0 auto;
}

.wordmark {
    width: 78dp;
    height: 20dp;
}

.breadcrumb {
    display: flex;
    align-items: center;
    gap: 6dp;
}

.title-right {
    position: relative;
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

.title-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46dp;
    height: 36dp;
}

.app-body {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
}

.content {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
}

.view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.status-bar {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 16dp;
    height: 28dp;
    padding: 0 12dp;
}

.status-left {
    flex: 1 1 0;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 16dp;
}

.status-item, .status-right {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 6dp;
}

.status-right {
    gap: 16dp;
}

.status-progress {
    width: 120dp;
}
