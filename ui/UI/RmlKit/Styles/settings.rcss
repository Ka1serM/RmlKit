.settings-nav-title { padding: 8dp 10dp 12dp 10dp; font-size: 18dp; font-weight: bold; }
#settings .category-item + .category-item { margin-top: 2dp; }

.settings-main { position: relative; flex: 1 1 0; min-width: 0; overflow-y: auto; padding: 24dp 32dp; }

.settings-header { display: flex; flex-direction: column; gap: 4dp; margin-bottom: 24dp; }
.settings-main .banner { margin-bottom: 24dp; }

.settings-section {
    display: flex;
    gap: 32dp;
    padding: 24dp 0;
    border-top: 1dp #2f2f2f;
}

.settings-section.disabled { opacity: 0.4; pointer-events: none; }

.settings-section-text { flex: 0 0 260dp; display: flex; flex-direction: column; gap: 4dp; }
.settings-section-form { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 10dp; max-width: 820dp; }

.settings-section-form .segment { align-self: flex-start; }
/*! Fields in a section stand apart like the onboarding form, so each label reads with its own input. */
.settings-section-form > .field + .field { margin-top: 14dp; }
.settings-section-form > .field + .field-actions { margin-top: 4dp; }



.button.small { height: 26dp; padding: 0 10dp; font-size: 12dp; }

.about .settings-header { margin-bottom: 0; padding-bottom: 20dp; }
.about .settings-section { padding: 16dp 0; }
.about .settings-section-form { gap: 8dp; }

.about-identity { display: flex; align-items: center; gap: 10dp; }
.about-logo { width: 22dp; height: 22dp; }
/*! Without a definite width, RmlUi sizes wrapping text in a flex column too short. */
.about-text { display: block; width: 720dp; max-width: 100%; }
.about-description { font-size: 13dp; color: #b3b3b3; }
.about-disclaimer { margin-top: 8dp; font-size: 12dp; color: #707070; }
.about-divider { height: 1dp; background-color: #2f2f2f; }
.about-copyright { font-size: 13dp; }
.about-warranty { margin-top: 6dp; line-height: 16dp; }

.about-row { display: flex; gap: 8dp; }
.about-person, .about-server {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10dp;
    border: 1dp #2f2f2f;
    border-radius: 4dp;
    background-color: #222222;
}
.about-person { padding: 8dp 6dp 8dp 10dp; }
.about-server { padding: 8dp; }
.about-avatar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28dp;
    height: 28dp;
    border-radius: 14dp;
    background-color: #2b2b2b;
}
.about-name { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }
.about-handle { display: flex; align-items: center; gap: 4dp; color: #707070; }
.about-handle svg { image-color: #707070; }
.about-socials { display: flex; }
.about-server-icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32dp;
    height: 32dp;
    border-radius: 4dp;
    background-color: #2b2b2b;
}

.about-libraries { display: flex; align-items: flex-start; gap: 8dp; }
.about-library-column {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border: 1dp #2f2f2f;
    border-radius: 4dp;
}
.about-library {
    display: flex;
    align-items: center;
    gap: 6dp;
    height: 28dp;
    padding: 0 10dp;
    border-bottom: 1dp #2f2f2f;
    font-size: 12dp;
}
.about-library:hover { background-color: #2b2b2b; }
.about-library:last-child { border-bottom: 0dp; }
