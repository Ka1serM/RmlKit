/*! The look of <color-picker>; an app overrides these rules in its own stylesheet. */

color-picker { display: flex; flex-direction: column; gap: 10dp; width: 220dp; }

color-picker .color-field { position: relative; height: 140dp; border-radius: 6dp; cursor: crosshair; drag: drag; decorator: linear-gradient(to right, #ffffff, #ffffff00), linear-gradient(to bottom, #00000000, #000000); }

color-picker .color-field-thumb { position: absolute; width: 12dp; height: 12dp; margin: -8dp 0 0 -8dp; border-width: 2dp; border-color: #ffffff; border-radius: 8dp; box-shadow: #00000080 0 1dp 3dp 0; }

color-picker .color-hue { position: relative; height: 12dp; border-radius: 6dp; cursor: ew-resize; drag: drag; decorator: linear-gradient(to right, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000); }

color-picker .color-hue-thumb { position: absolute; top: -2dp; width: 6dp; height: 12dp; margin-left: -5dp; border-width: 2dp; border-color: #ffffff; border-radius: 4dp; box-shadow: #00000080 0 1dp 3dp 0; }

color-picker .color-row { display: flex; align-items: center; gap: 8dp; }

color-picker .color-swatch { flex: 0 0 24dp; height: 24dp; border-width: 1dp; border-color: #ffffff1f; border-radius: 6dp; }

color-picker .color-hex { flex: 1 1 0; height: 24dp; padding: 0 8dp; line-height: 24dp; border-width: 1dp; border-color: #ffffff14; border-radius: 6dp; background-color: #00000040; color: #ffffff; font-size: 12dp; }
