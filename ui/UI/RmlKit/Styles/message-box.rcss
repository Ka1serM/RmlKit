.message-box-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.message-box {
    position: absolute;
    left: 50%;
    top: 30%;
    width: 440dp;
    margin-left: -220dp;
}

.message-box-body { display: flex; flex-direction: column; gap: 6dp; padding: 16dp 12dp; }

.message-box-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8dp;
    padding: 12dp;
    border-top-width: 1dp;
}
