.logs-columns { flex: 1 1 0; min-height: 0; display: flex; gap: 14dp; }

.logs-main { flex: 1 1 0; min-width: 0; }

.logs-details { flex: 0 0 420dp; }

.logs-filters {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8dp;
    padding: 12dp;
    border-bottom-width: 1dp;
}

.logs-filters .input.search { width: 240dp; }

.logs-filters .logs-source { width: 180dp; }

.segment.levels { padding: 3dp; }

.segment.levels .segment-count {
    padding: 1dp 5dp;
}

.logs-body { display: block; flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 8dp 0; }

/*! Block rows: RmlUi lays out every row again on any layout change, and flex rows cost more. */
.logs-body .log-line {
    display: block;
    position: relative;
    height: 22dp;
    padding: 3dp 12dp 3dp 160dp;
    box-sizing: border-box;
    border-left-width: 2dp;
    font-size: 13dp;
    line-height: 16dp;
}

.logs-body .log-time { position: absolute; top: 3dp; left: 10dp; }

.logs-body .log-level { position: absolute; top: 3dp; left: 116dp; width: 36dp; }

.log-text {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.log-copy {
    visibility: hidden;
    position: absolute;
    top: 1dp;
    right: 8dp;
    width: 20dp;
    height: 20dp;
}

.logs-body .log-line:hover .log-copy { visibility: visible; }

.log-detail-message { font-size: 14dp; word-break: break-word; }

.logs-footer {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8dp;
    height: 36dp;
    padding: 0 12dp;
    border-top-width: 1dp;
    font-size: 12dp;
}

.details-body { flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 12dp 16dp; }

.details-footer { flex: 0 0 auto; display: flex; gap: 8dp; padding: 12dp 16dp; border-top-width: 1dp; }

.details-stack { display: flex; flex-direction: column; gap: 12dp; }
