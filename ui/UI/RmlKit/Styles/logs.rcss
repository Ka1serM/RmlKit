.logs-columns { flex: 1 1 0; min-height: 0; display: flex; gap: 14dp; }
.logs-main { flex: 1 1 0; min-width: 0; }
.logs-details { flex: 0 0 420dp; }

.logs-filters {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8dp;
    padding: 12dp;
    border-bottom: 1dp #2f2f2f;
}

.logs-filters .input.search { width: 240dp; }
.logs-filters .logs-source { width: 180dp; }

.segment.levels { padding: 3dp; }
.segment.levels .segment-item { text-transform: uppercase; }
.segment.levels .segment-count {
    padding: 1dp 5dp;
    border-radius: 2dp;
    background-color: #353535;
    font-family: Google Sans;
    font-weight: bold;
    color: #b3b3b3;
}
.segment.levels .segment-item.on .segment-count { background-color: #111111; color: #ffffff; }

.logs-body { display: block; flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 8dp 0; }

/*! Block rows: RmlUi lays out every row again on any layout change, and flex rows cost more. */
.logs-body .log-line {
    display: block;
    position: relative;
    height: 22dp;
    padding: 3dp 12dp 3dp 160dp;
    box-sizing: border-box;
    border-left: 2dp transparent;
    font-family: Google Sans Code;
    font-size: 13dp;
    line-height: 16dp;
}
.logs-body .log-time { position: absolute; top: 3dp; left: 10dp; color: #707070; }
.logs-body .log-level { position: absolute; top: 3dp; left: 116dp; width: 36dp; color: #707070; }
.log-line.warn { background-color: #f5c24224; }
.log-line.warn .log-level { color: #f5c242; }
.log-line.err { background-color: #ff465524; }
.log-line.err .log-level { color: #ff4655; }
.log-line.done .log-level { color: #38d39f; }
.logs-body .log-line:hover { background-color: #ffffff0a; }
.logs-body .log-line.warn:hover { background-color: #f5c24233; }
.logs-body .log-line.err:hover { background-color: #ff465533; }
.logs-body .log-line.selected { border-left-color: #ff4655; background-color: #ffffff0f; }

.log-text {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #b3b3b3;
}
.logs-body .log-line.done .log-text, .logs-body .log-line.warn .log-text, .logs-body .log-line.err .log-text { color: #ffffff; }

.log-copy {
    visibility: hidden;
    position: absolute;
    top: 1dp;
    right: 8dp;
    width: 20dp;
    height: 20dp;
    background-color: #2b2b2b;
}
.logs-body .log-line:hover .log-copy { visibility: visible; }

.log-detail-message { font-size: 14dp; font-weight: bold; color: #ffffff; word-break: break-word; }

.logs-footer {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8dp;
    height: 36dp;
    padding: 0 12dp;
    border-top: 1dp #2f2f2f;
    font-size: 12dp;
}

.details-body { flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 12dp 16dp; }
.details-footer { flex: 0 0 auto; display: flex; gap: 8dp; padding: 12dp 16dp; border-top: 1dp #2f2f2f; }
.details-stack { display: flex; flex-direction: column; gap: 12dp; }
