.row { display: flex; align-items: center; gap: 8dp; }

.column { display: flex; flex-direction: column; }

.grow { flex: 1 1 0; min-width: 0; }

.fixed { flex: 0 0 auto; }

.wrap { flex-wrap: wrap; }

.clip { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.hidden-scroll { overflow: hidden; }

.scroll-y { overflow-y: auto; }

body.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.small { font-size: 12dp; }

.mono.small { font-size: 11dp; }

.title-section { font-size: 18dp; }

.title-card { font-size: 14dp; }

.body-strong { font-size: 13dp; }

.body-regular { font-size: 13dp; }

.caps {
    font-size: 11dp;
}

.micro {
    font-size: 10dp;
}

.icon-12, .icon-14, .icon-16, .icon-20, .icon-24 {
    flex: 0 0 auto;
}

.icon-12 { width: 12dp; height: 12dp; }

.icon-14 { width: 14dp; height: 14dp; }

.icon-16 { width: 16dp; height: 16dp; }

.icon-20 { width: 20dp; height: 20dp; }

.icon-24 { width: 24dp; height: 24dp; }

spinner { display: block; flex: 0 0 auto; }

img { decorator: texture-loading(); }

.button {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6dp;
    height: 32dp;
    padding: 0 12dp;
    box-sizing: border-box;
    border-width: 1dp;
    font-size: 13dp;
    white-space: nowrap;
}

.button.wide { flex: 1 1 0; }

.icon-button {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28dp;
    height: 28dp;
    box-sizing: border-box;
    border-width: 1dp;
}

.icon-button.large { width: 32dp; height: 32dp; }

.badge {
    flex: 0 0 auto;
    padding: 2dp 6dp;
    font-size: 10dp;
    white-space: nowrap;
}

.kbd {
    flex: 0 0 auto;
    padding: 1dp 5dp;
    border-width: 1dp 1dp 2dp 1dp;
    font-size: 11dp;
}

.status-dot {
    flex: 0 0 auto;
    width: 8dp;
    height: 8dp;
}

.progress {
    height: 4dp;
    overflow: hidden;
}

.progress-fill {
    height: 4dp;
}

input[type=checkbox] {
    flex: 0 0 auto;
    width: 16dp;
    height: 16dp;
    box-sizing: border-box;
    border-width: 1dp;
}

/*! RmlUi resolves an svg() decorator against the document, not the stylesheet, so these paths assume a document in UI/Documents. */
input[type=checkbox]:checked {
    decorator: svg(/UI/RmlKit/Icons/icon-check.svg);
}

input[type=radio] {
    flex: 0 0 auto;
    width: 16dp;
    height: 16dp;
    box-sizing: border-box;
    border-width: 1dp;
}

.toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8dp;
}

.toggle input {
    width: 28dp;
    height: 16dp;
    border: 0;
    decorator: none;
}

.toggle input:checked { decorator: none; }

.toggle-knob {
    position: absolute;
    left: 2dp;
    top: 50%;
    width: 12dp;
    height: 12dp;
    margin-top: -6dp;
    transition: left 0.12s cubic-out;
}

.toggle input:checked + .toggle-knob {
    left: 14dp;
}

.input {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8dp;
    height: 32dp;
    padding: 0 4dp 0 10dp;
    box-sizing: border-box;
    border-width: 1dp;
    font-size: 13dp;
}

.input-field {
    flex: 1 1 0;
    min-width: 0;
    height: 18dp;
    line-height: 18dp;
    border: 0;
    font-size: 13dp;
}

.input-value {
    flex: 1 1 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.input-trailing {
    display: flex;
    align-items: center;
    height: 24dp;
    padding: 0 8dp;
    font-size: 10dp;
}

.input.select { padding-right: 10dp; }

.input.select-small { height: 28dp; }

select.input { display: block; padding: 0 10dp; }

select selectvalue { height: 30dp; margin-right: 20dp; line-height: 30dp; white-space: nowrap; text-overflow: ellipsis; }

select selectarrow {
    width: 14dp;
    height: 14dp;
    margin: 8dp 10dp 0 0;
    decorator: svg(/UI/RmlKit/Icons/icon-chevron-down.svg);
}

select selectbox {
    margin-top: 4dp;
    padding: 4dp;
    border-width: 1dp;
}

select selectbox option { padding: 6dp 8dp; }

.input.search { min-width: 160dp; padding-right: 8dp; }

.field { display: flex; flex-direction: column; gap: 6dp; }

.field-label {
    font-size: 11dp;
}

.helper { display: flex; align-items: center; gap: 6dp; font-size: 12dp; }

.segment {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 2dp;
    padding: 2dp;
    box-sizing: border-box;
    border-width: 1dp;
}

.segment-item {
    display: flex;
    align-items: center;
    gap: 6dp;
    height: 30dp;
    padding: 0 12dp 0 10dp;
    font-size: 12dp;
}

.segment.small .segment-item {
    height: 20dp;
    padding: 0 6dp 0 5dp;
    font-size: 11dp;
    gap: 4dp;
}

.segment.group-by { padding: 5dp; }

.segment-count {
    font-size: 10dp;
}

.tabs {
    flex: 0 0 auto;
    display: flex;
    align-items: stretch;
    gap: 20dp;
    height: 37dp;
    padding: 0 24dp;
    border-bottom-width: 1dp;
}

.tab {
    display: flex;
    align-items: center;
    gap: 6dp;
    border-bottom-width: 2dp;
    font-size: 12dp;
}

.tab-count { font-size: 10dp; }

.nav-rail {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4dp;
    width: 75dp;
    padding: 8dp 6dp;
    box-sizing: border-box;
    border-right-width: 1dp;
}

.nav-spacer { flex: 1 1 0; }

.nav-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4dp;
    width: 63dp;
    height: 52dp;
    font-size: 10dp;
}

body[nav="none"] .nav-rail { display: none; }

.nav-item.active .nav-indicator { display: block; }

.nav-indicator {
    display: none;
    position: absolute;
    left: -6dp;
    top: 14dp;
    width: 2dp;
    height: 24dp;
}

.category-item {
    display: flex;
    align-items: center;
    gap: 10dp;
    height: 30dp;
    padding: 0 10dp;
    font-size: 13dp;
}

.category-count {
    margin-left: auto;
    font-size: 11dp;
}

.sidebar-heading {
    padding: 12dp 10dp 4dp 10dp;
    font-size: 11dp;
}

.stat {
    display: flex;
    flex-direction: column;
    gap: 4dp;
    padding: 14dp 16dp;
    border-width: 1dp;
}

.stat-value { font-size: 28dp; }

.stat-delta { font-size: 11dp; }

.panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-width: 1dp;
}

.panel-header {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8dp;
    height: 36dp;
    padding: 0 12dp;
    box-sizing: border-box;
    border-bottom-width: 1dp;
}

.panel-title {
    font-size: 11dp;
}

.panel-count { font-size: 11dp; }

.panel-link {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4dp;
    font-size: 12dp;
}

.panel-body { flex: 1 1 0; min-height: 0; }

.page {
    display: flex;
    flex-direction: column;
    gap: 12dp;
    height: 100%;
    padding: 16dp;
    box-sizing: border-box;
}

.page-header {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 24dp;
}

.page-header-title { flex: 0 0 auto; display: flex; flex-direction: column; gap: 2dp; }

.page-header-actions { margin-left: auto; display: flex; align-items: center; gap: 8dp; }

.page-divider { flex: 0 0 auto; width: 1dp; height: 36dp; }

.page-title { font-size: 22dp; }

.page-subtitle { font-size: 12dp; }

.meta-item { display: flex; flex-direction: column; gap: 4dp; flex: 0 0 auto; }

.meta-label {
    display: flex;
    align-items: center;
    gap: 4dp;
    font-size: 11dp;
}

.meta-value { font-size: 13dp; }

.sidebar {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    width: 232dp;
    padding: 8dp;
    box-sizing: border-box;
    border-right-width: 1dp;
}

.inspector {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    width: 440dp;
    box-sizing: border-box;
    border-left-width: 1dp;
}

.main { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }

.split { display: flex; height: 100%; }

virtual-grid { display: block; }

.grid-header { display: flex; align-items: flex-end; padding-bottom: 10dp; box-sizing: border-box; }

.grid-header .group-header { flex: 1 1 auto; }

.grid-row { display: flex; gap: 12dp; align-items: flex-start; padding-bottom: 12dp; }

.grid-item { flex: 1 1 0; }

.grid-filler { flex: 0 1 0; }

.group-header {
    display: flex;
    align-items: center;
    gap: 8dp;
    height: 32dp;
}

.group-toggle { flex: 1 1 auto; display: flex; align-items: center; gap: 8dp; height: 32dp; }

.group-toggle:hover .group-name { text-decoration: underline; }

.group-name { font-size: 14dp; }

.group-count { font-size: 11dp; }

.group-action { margin-left: auto; font-size: 13dp; }

.content-list {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-width: 1dp;
}

.content-row {
    display: flex;
    align-items: center;
    gap: 12dp;
    height: 52dp;
    padding: 0 16dp;
}

/*! RmlUi keeps a data-for element as a hidden last child, so :last-child never matches the last shown row. */
.content-row + .content-row, .content-slot + .content-slot .content-row { border-top-width: 1dp; }

.content-row.locked { height: 36dp; }

.content-text { flex: 1 1 0; display: flex; flex-direction: column; gap: 1dp; }

.content-icon { flex: 0 0 auto; width: 16dp; height: 16dp; }

.content-title { font-size: 13dp; }

.content-detail { font-size: 12dp; }

.content-meta { font-size: 11dp; }

.options { display: flex; align-items: flex-start; gap: 12dp; }

.option-card {
    flex: 1 1 0;
    display: flex;
    align-items: flex-start;
    gap: 12dp;
    padding: 12dp 14dp;
    border-width: 1dp;
}

.option-icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32dp;
    height: 32dp;
}

.option-text { flex: 1 1 0; display: flex; flex-direction: column; gap: 3dp; }

.option-title { font-size: 13dp; }

.option-detail { font-size: 12dp; }

.option-stack { display: flex; flex-direction: column; gap: 8dp; }

.option-stack .option-card { flex: 0 0 auto; }

.step { display: flex; align-items: center; gap: 10dp; }

.step-index {
    width: 24dp;
    height: 24dp;
    box-sizing: border-box;
    border-width: 1dp;
    font-size: 10dp;
    line-height: 22dp;
    text-align: center;
}

.step-index.done {
    display: flex;
    align-items: center;
    justify-content: center;
}

.step-title { font-size: 13dp; }

.step-detail { font-size: 12dp; }

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8dp;
    padding: 32dp;
    text-align: center;
}

.empty-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48dp;
    height: 48dp;
}

.empty-title { font-size: 14dp; }

.empty-message { width: 320dp; max-width: 100%; font-size: 13dp; }

.menu {
    display: flex;
    flex-direction: column;
    padding: 4dp;
    border-width: 1dp;
}

.menu-item {
    display: flex;
    align-items: center;
    gap: 10dp;
    height: 30dp;
    padding: 0 8dp;
    font-size: 13dp;
}

.menu-chevron { margin-left: auto; }

.menu-separator { height: 1dp; margin: 4dp 0; }

.toast {
    display: flex;
    align-items: flex-start;
    gap: 10dp;
    width: 360dp;
    padding: 12dp;
    box-sizing: border-box;
    border-left-width: 3dp;
}

.toast-text { flex: 1 1 0; display: flex; flex-direction: column; gap: 2dp; }

.toast-title { font-size: 13dp; }

.toast-message { font-size: 12dp; }

.toast-action {
    margin-top: 6dp;
    font-size: 10dp;
}

.banner {
    display: flex;
    align-items: center;
    gap: 12dp;
    padding: 10dp 12dp;
    border-width: 1dp;
}

.banner-text { flex: 1 1 0; display: flex; flex-direction: column; gap: 2dp; }

.banner-title { font-size: 13dp; }

.banner-message { font-size: 12dp; }

.video-badge {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 4dp;
    padding: 2dp 6dp 2dp 4dp;
    font-size: 11dp;
}

.chips {
    display: flex;
    gap: 2dp;
    padding: 3dp;
}

.chip {
    display: block;
    padding: 3dp 8dp;
    font-size: 11dp;
}

.section-head { display: flex; align-items: center; gap: 6dp; height: 14dp; }

.section-head .caps { flex: 1 1 0; }

.section-action { font-size: 12dp; }

.section-value { font-size: 11dp; }

.section { display: flex; flex-direction: column; gap: 8dp; }

.note { display: flex; align-items: center; gap: 6dp; font-size: 12dp; }

.note svg { flex: 0 0 auto; width: 12dp; height: 12dp; }

.note p { flex: 1 1 0; }

.video-controls {
    position: absolute;
    z-index: 1;
    left: 0;
    bottom: 0;
    width: 100%;
    box-sizing: border-box;
    display: none;
    align-items: center;
    gap: 10dp;
    padding: 14dp 12dp 8dp 12dp;
}

video.loaded:hover .video-controls, video.loaded.paused .video-controls { display: flex; }

.video-controls .video-toggle, .video-controls .video-mute, .video-controls .video-maximize { flex: 0 0 auto; display: flex; width: 16dp; height: 16dp; }

.video-controls .video-toggle svg, .video-controls .video-mute svg, .video-controls .video-maximize svg { width: 16dp; height: 16dp; }

.video-mute .video-muted-icon { display: none; }

video.muted .video-mute .video-muted-icon { display: block; }

video.muted .video-mute .video-volume-icon { display: none; }

.video-maximize .video-minimize-icon { display: none; }

video.maximized .video-maximize .video-minimize-icon { display: block; }

video.maximized .video-maximize .video-maximize-icon { display: none; }

video.maximized { z-index: 1000; clip: none; }

.video-toggle .video-play-icon { display: none; }

video.paused .video-toggle .video-play-icon { display: block; }

video.paused .video-toggle .video-pause-icon { display: none; }

.video-seek, .video-volume { display: flex; align-items: center; height: 14dp; drag: drag; }

.video-seek { flex: 1 1 auto; }

.video-volume { flex: 0 0 56dp; }

.video-seek-line, .video-volume-line { flex: 1 1 auto; height: 3dp; }

.video-seek-fill, .video-volume-fill { width: 0; height: 3dp; }

.video-clock { flex: 0 0 auto; font-size: 11dp; }

.video-play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border-width: 1.5dp;
}

.video-play.large { width: 60dp; height: 60dp; margin: -30dp 0 0 -30dp; }

.video-play.large svg { width: 24dp; height: 24dp; }

.video-play.small { width: 44dp; height: 44dp; margin: -22dp 0 0 -22dp; }

.video-play.small svg { width: 18dp; height: 18dp; }

.video-source {
    display: flex;
    align-items: center;
    gap: 6dp;
    padding: 3dp 8dp;
    font-size: 11dp;
    white-space: nowrap;
}

.video-source.large { padding: 5dp 8dp; }

.tooltip {
    display: flex;
    align-items: center;
    gap: 6dp;
    padding: 5dp 8dp;
    border-width: 1dp;
    font-size: 12dp;
    white-space: nowrap;
}

.export-button {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6dp;
    height: 32dp;
    padding: 0 12dp;
    font-size: 13dp;
    white-space: nowrap;
}

.export-count { font-size: 11dp; }

.export-button.grow { flex: 1 1 0; min-width: 0; }

.table {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-width: 1dp;
}

.table-head {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    height: 32dp;
    padding: 0 8dp;
    box-sizing: border-box;
    border-bottom-width: 1dp;
}

.table-head span {
    font-size: 11dp;
}

.table-body { flex: 1 1 0; min-height: 0; overflow-y: auto; }

.filters { flex: 0 0 auto; display: flex; align-items: center; gap: 8dp; }

.filters-end { margin-left: auto; display: flex; align-items: center; gap: 8dp; }

.push-end { margin-left: auto; }

.tooltip.floating {
    display: none;
    position: fixed;
    z-index: 10000;
    pointer-events: none;
}

.tooltip.floating.shown { display: flex; }

.inspector-back {
    flex: 0 0 auto;
    display: none;
    align-items: center;
    height: 44dp;
    padding: 0 8dp;
    border-bottom-width: 1dp;
}

/*! <splitter>: a thin handle between two panels; "vertical" sits between columns, "horizontal" between rows. */
splitter { display: block; flex: 0 0 auto; drag: drag; }

splitter.vertical { width: 6dp; margin: 0 -2dp; cursor: ew-resize; }

splitter.horizontal { height: 6dp; margin: -2dp 0; cursor: ns-resize; }

/*! The menu of a text field (TextMenu.cpp), which RmlKit adds to the document of the field. */
.text-menu {
    position: absolute;
    z-index: 10000;
    min-width: 200dp;
    box-sizing: border-box;
}

.text-menu .kbd { margin-left: auto; }
