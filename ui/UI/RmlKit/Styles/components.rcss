.row { display: flex; align-items: center; gap: 8dp; }

.column { display: flex; flex-direction: column; }

.grow { flex: 1 1 0; min-width: 0; }

.fixed { flex: 0 0 auto; }

.wrap { flex-wrap: wrap; }

.clip { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.hidden-scroll { overflow: hidden; }

.scroll-y { overflow-y: auto; }

body.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
}

.text-primary { color: #ffffff; }

.text-secondary { color: #b3b3b3; }

.text-muted { color: #707070; }

.text-success { color: #38d39f; }

.text-warning { color: #f5c242; }

.text-danger { color: #ff4655; }

.text-info { color: #2ca7f6; }

.mono { font-family: Google Sans Code; }

.small { font-size: 12dp; }

.mono.small { font-size: 11dp; }

.title-section { font-size: 18dp; font-weight: bold; }

.title-card { font-size: 14dp; font-weight: bold; }

.body-strong { font-size: 13dp; font-weight: bold; }

.body-regular { font-size: 13dp; font-weight: normal; }

.caps {
    font-size: 11dp;
    font-weight: 500;
    letter-spacing: 0.66dp;
    text-transform: uppercase;
    color: #707070;
}

.micro {
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 0.4dp;
    text-transform: uppercase;
}

.icon-12, .icon-14, .icon-16, .icon-20, .icon-24 {
    flex: 0 0 auto;
    image-color: #b3b3b3;
}

.icon-12 { width: 12dp; height: 12dp; }

.icon-14 { width: 14dp; height: 14dp; }

.icon-16 { width: 16dp; height: 16dp; }

.icon-20 { width: 20dp; height: 20dp; }

.icon-24 { width: 24dp; height: 24dp; }

.icon-primary { image-color: #ffffff; }

.icon-muted { image-color: #707070; }

.icon-inverse { image-color: #111111; }

.icon-success { image-color: #38d39f; }

.icon-warning { image-color: #f5c242; }

.icon-danger { image-color: #ff4655; }

.icon-info { image-color: #2ca7f6; }

spinner { display: block; flex: 0 0 auto; image-color: #b3b3b3; }

img { decorator: texture-loading(); }

.button {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6dp;
    height: 32dp;
    padding: 0 12dp;
    box-sizing: border-box;
    border: 1dp #4a4a4a;
    border-radius: 4dp;
    background-color: #2b2b2b;
    font-size: 13dp;
    white-space: nowrap;
    color: #ffffff;
}

.button svg { image-color: #ffffff; }

.button:hover { background-color: #353535; }

.button.primary {
    background-color: #f2f2f2;
    border-color: #f2f2f2;
    color: #111111;
}

.button.primary svg { image-color: #111111; }

.button.primary:hover { background-color: #ffffff; }

.button.ghost {
    background-color: transparent;
    border-color: transparent;
}

.button.ghost:hover { background-color: #353535; }

.button.danger { color: #ff4655; }

.button.danger svg { image-color: #ff4655; }

.button.wide { flex: 1 1 0; }

.button:disabled, .button.disabled { opacity: 0.4; }

.icon-button {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28dp;
    height: 28dp;
    box-sizing: border-box;
    border: 1dp transparent;
    border-radius: 4dp;
}

.icon-button svg { image-color: #b3b3b3; }

.icon-button:hover { background-color: #353535; }

.icon-button:active { background-color: #ffffff0f; }

.icon-button.secondary {
    background-color: #2b2b2b;
    border-color: #2f2f2f;
}

.icon-button.secondary:hover { background-color: #353535; }

.icon-button.active svg { image-color: #ffffff; }

.icon-button.large { width: 32dp; height: 32dp; }

.icon-button.on { background-color: #f2f2f2; border-color: #f2f2f2; }

.icon-button.on svg { image-color: #111111; }

.icon-button.disabled { opacity: 0.4; }

.icon-button.disabled:hover { background-color: transparent; }

.icon-button.secondary.disabled:hover { background-color: #2b2b2b; }

.badge {
    flex: 0 0 auto;
    padding: 2dp 6dp;
    border-radius: 2dp;
    background-color: #2b2b2b;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 0.4dp;
    text-transform: uppercase;
    white-space: nowrap;
    color: #b3b3b3;
}

.badge.success { background-color: #38d39f24; color: #38d39f; }

.badge.warning { background-color: #f5c24224; color: #f5c242; }

.badge.danger { background-color: #ff465524; color: #ff4655; }

.badge.info { background-color: #2ca7f624; color: #2ca7f6; }

.badge.solid { background-color: #f2f2f2; color: #111111; }

.badge.new { background-color: #0a2a40; color: #2ca7f6; }

.kbd {
    flex: 0 0 auto;
    padding: 1dp 5dp;
    background-color: #2b2b2b;
    border-width: 1dp 1dp 2dp 1dp;
    border-color: #4a4a4a;
    border-radius: 2dp;
    font-family: Google Sans Code;
    font-size: 11dp;
    color: #b3b3b3;
}

.status-dot {
    flex: 0 0 auto;
    width: 8dp;
    height: 8dp;
    border-radius: 4dp;
    background-color: #707070;
}

.status-dot.online { background-color: #38d39f; }

.status-dot.busy { background-color: #f5c242; }

.status-dot.error { background-color: #ff4655; }

.status-dot.info { background-color: #2ca7f6; }

.progress {
    height: 4dp;
    overflow: hidden;
    border-radius: 2dp;
    background-color: #404040;
}

.progress-fill {
    height: 4dp;
    border-radius: 2dp;
    background-color: #ffffff;
}

.progress-fill.info { background-color: #2ca7f6; }

.progress-fill.success { background-color: #38d39f; }

.progress-fill.danger { background-color: #ff4655; }

input[type=checkbox] {
    flex: 0 0 auto;
    width: 16dp;
    height: 16dp;
    box-sizing: border-box;
    border: 1dp #4a4a4a;
    border-radius: 2dp;
    background-color: #161616;
}

input[type=checkbox]:hover { border-color: #707070; }

input[type=checkbox]:disabled { border-color: #4a4a4a; }

/*! RmlUi resolves an svg() decorator against the document, not the stylesheet, so these paths assume a document in UI/Documents. */
input[type=checkbox]:checked {
    background-color: #f2f2f2;
    border-color: #f2f2f2;
    decorator: svg(/UI/RmlKit/Icons/icon-check.svg);
    image-color: #111111;
}

input[type=radio] {
    flex: 0 0 auto;
    width: 16dp;
    height: 16dp;
    box-sizing: border-box;
    border: 1dp #4a4a4a;
    border-radius: 8dp;
    background-color: #161616;
}

input[type=radio]:checked {
    border-color: #ffffff;
    box-shadow: #ffffff 0 0 0 4dp inset;
}

.toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8dp;
}

.toggle input {
    width: 28dp;
    height: 16dp;
    border: 0;
    border-radius: 8dp;
    background-color: #353535;
    decorator: none;
}

.toggle input:checked { background-color: #f2f2f2; decorator: none; }

.toggle-knob {
    position: absolute;
    left: 2dp;
    top: 50%;
    width: 12dp;
    height: 12dp;
    margin-top: -6dp;
    border-radius: 6dp;
    background-color: #b3b3b3;
    transition: left 0.12s cubic-out;
}

.toggle input:checked + .toggle-knob {
    left: 14dp;
    background-color: #111111;
}

.input {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8dp;
    height: 32dp;
    padding: 0 4dp 0 10dp;
    box-sizing: border-box;
    border: 1dp #2f2f2f;
    border-radius: 4dp;
    background-color: #161616;
    font-size: 13dp;
    color: #ffffff;
}

.input:hover { border-color: #4a4a4a; }

.input.focus { border-color: #ffffff8c; }

.input.error { border-color: #ff4655; }

.input.disabled { background-color: #222222; color: #707070; }

.input-field {
    flex: 1 1 0;
    min-width: 0;
    height: 18dp;
    line-height: 18dp;
    border: 0;
    background-color: transparent;
    font-size: 13dp;
    color: #ffffff;
    caret-color: #ffffff;
}

.input-field.mono, .input-value.mono { font-family: Google Sans Code; }

.input-value {
    flex: 1 1 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.input-trailing {
    display: flex;
    align-items: center;
    height: 24dp;
    padding: 0 8dp;
    border-radius: 2dp;
    background-color: #2b2b2b;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 0.4dp;
    text-transform: uppercase;
    color: #b3b3b3;
}

.input-trailing:hover { background-color: #4a4a4a; }

.input.select { padding-right: 10dp; }

.input.select .input-value { color: #ffffff; }

.input.select-small { height: 28dp; }

select.input { display: block; padding: 0 10dp; }

select selectvalue { height: 30dp; margin-right: 20dp; line-height: 30dp; white-space: nowrap; text-overflow: ellipsis; }

select selectarrow {
    width: 14dp;
    height: 14dp;
    margin: 8dp 10dp 0 0;
    decorator: svg(/UI/RmlKit/Icons/icon-chevron-down.svg);
    image-color: #b3b3b3;
}

select selectbox {
    margin-top: 4dp;
    padding: 4dp;
    border: 1dp #2f2f2f;
    border-radius: 4dp;
    background-color: #1c1c1c;
}

select selectbox option { padding: 6dp 8dp; border-radius: 2dp; color: #b3b3b3; }

select selectbox option:hover { background-color: #2b2b2b; color: #ffffff; }

select selectbox option:checked { color: #ffffff; }

.input.search { min-width: 160dp; padding-right: 8dp; }

input.input-field:placeholder-shown, .input-hint { color: #707070; }

.field { display: flex; flex-direction: column; gap: 6dp; }

.field-label {
    font-size: 11dp;
    letter-spacing: 0.66dp;
    text-transform: uppercase;
    color: #707070;
}

.helper { display: flex; align-items: center; gap: 6dp; font-size: 12dp; color: #b3b3b3; }

.segment {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 2dp;
    padding: 2dp;
    box-sizing: border-box;
    border: 1dp #2f2f2f;
    border-radius: 4dp;
    background-color: #161616;
}

.segment-item {
    display: flex;
    align-items: center;
    gap: 6dp;
    height: 30dp;
    padding: 0 12dp 0 10dp;
    border-radius: 2dp;
    font-size: 12dp;
    font-weight: bold;
    letter-spacing: 0.48dp;
    color: #707070;
}

.segment-item:hover { background-color: #353535; color: #b3b3b3; }

.segment-item.on { background-color: #f2f2f2; color: #111111; }

.segment.small .segment-item {
    height: 20dp;
    padding: 0 6dp 0 5dp;
    font-size: 11dp;
    font-weight: bold;
    letter-spacing: 0.44dp;
    gap: 4dp;
}

.segment.group-by { padding: 5dp; }

.segment.group-by .segment-item { text-transform: uppercase; }

.segment-count {
    font-family: Google Sans Code;
    font-size: 10dp;
    color: #707070;
}

.segment-item.on .segment-count { color: #111111; }

.tabs {
    flex: 0 0 auto;
    display: flex;
    align-items: stretch;
    gap: 20dp;
    height: 37dp;
    padding: 0 24dp;
    border-bottom: 1dp #2f2f2f;
}

.tab {
    display: flex;
    align-items: center;
    gap: 6dp;
    border-bottom: 2dp transparent;
    font-size: 12dp;
    font-weight: bold;
    letter-spacing: 0.48dp;
    text-transform: uppercase;
    color: #707070;
}

.tab:hover { border-bottom-color: #4a4a4a; color: #b3b3b3; }

.tab.on { border-bottom-color: #ffffff; color: #ffffff; }

.tab-count { font-family: Google Sans Code; font-size: 10dp; color: #707070; }

.nav-rail {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4dp;
    width: 75dp;
    padding: 8dp 6dp;
    box-sizing: border-box;
    background-color: #141414;
    border-right: 1dp #2f2f2f;
}

.nav-spacer { flex: 1 1 0; }

.nav-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4dp;
    width: 63dp;
    height: 52dp;
    border-radius: 4dp;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 0.4dp;
    color: #707070;
}

.nav-item svg { image-color: #b3b3b3; }

.nav-item:hover { background-color: #2b2b2b; }

body[nav="none"] .nav-rail { display: none; }

body[nav="home"] .nav-item[nav="home"],
body[nav="library"] .nav-item[nav="library"],
body[nav="replays"] .nav-item[nav="replays"],
body[nav="logs"] .nav-item[nav="logs"],
body[nav="settings"] .nav-item[nav="settings"] { background-color: #ffffff0f; color: #ffffff; }

body[nav="home"] .nav-item[nav="home"] svg,
body[nav="library"] .nav-item[nav="library"] svg,
body[nav="replays"] .nav-item[nav="replays"] svg,
body[nav="logs"] .nav-item[nav="logs"] svg,
body[nav="settings"] .nav-item[nav="settings"] svg { image-color: #ffffff; }

body[nav="home"] .nav-item[nav="home"] .nav-indicator,
body[nav="library"] .nav-item[nav="library"] .nav-indicator,
body[nav="replays"] .nav-item[nav="replays"] .nav-indicator,
body[nav="logs"] .nav-item[nav="logs"] .nav-indicator,
body[nav="settings"] .nav-item[nav="settings"] .nav-indicator { display: block; }

.nav-indicator {
    display: none;
    position: absolute;
    left: -6dp;
    top: 14dp;
    width: 2dp;
    height: 24dp;
    background-color: #ffffff;
}

.category-item {
    display: flex;
    align-items: center;
    gap: 10dp;
    height: 30dp;
    padding: 0 10dp;
    border-radius: 4dp;
    font-size: 13dp;
    color: #b3b3b3;
}

.category-item:hover { background-color: #2b2b2b; }

.category-item.active { background-color: #ffffff0f; color: #ffffff; }

.category-item.active svg { image-color: #ffffff; }

.category-count {
    margin-left: auto;
    font-family: Google Sans Code;
    font-size: 11dp;
    color: #707070;
}

.category-item.active .category-count { color: #ffffff; }

.sidebar-heading {
    padding: 12dp 10dp 4dp 10dp;
    font-size: 11dp;
    letter-spacing: 0.66dp;
    text-transform: uppercase;
    color: #707070;
}

.stat {
    display: flex;
    flex-direction: column;
    gap: 4dp;
    padding: 14dp 16dp;
    border: 1dp #2f2f2f;
    border-radius: 4dp;
    background-color: #222222;
}

.stat-value { font-family: Google Sans Code; font-size: 28dp; }

.stat-delta { font-family: Google Sans Code; font-size: 11dp; color: #38d39f; }

.panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1dp #2f2f2f;
    border-radius: 4dp;
    background-color: #222222;
}

.panel-header {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8dp;
    height: 36dp;
    padding: 0 12dp;
    box-sizing: border-box;
    border-bottom: 1dp #2f2f2f;
}

.panel-title {
    font-size: 11dp;
    font-weight: bold;
    letter-spacing: 0.66dp;
    text-transform: uppercase;
}

.panel-count { font-family: Google Sans Code; font-size: 11dp; color: #707070; }

.panel-link {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4dp;
    font-size: 12dp;
    color: #b3b3b3;
}

.panel-link:hover { color: #ffffff; }

.panel-body { flex: 1 1 0; min-height: 0; }

.page {
    display: flex;
    flex-direction: column;
    gap: 12dp;
    height: 100%;
    padding: 16dp;
    box-sizing: border-box;
}

.page-header {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 24dp;
}

.page-header-title { flex: 0 0 auto; display: flex; flex-direction: column; gap: 2dp; }

.page-header-actions { margin-left: auto; display: flex; align-items: center; gap: 8dp; }

.page-divider { flex: 0 0 auto; width: 1dp; height: 36dp; background-color: #2f2f2f; }

.page-title { font-size: 22dp; font-weight: bold; }

.page-subtitle { font-size: 12dp; color: #707070; }

.meta-item { display: flex; flex-direction: column; gap: 4dp; flex: 0 0 auto; }

.meta-label {
    display: flex;
    align-items: center;
    gap: 4dp;
    font-size: 11dp;
    letter-spacing: 0.66dp;
    text-transform: uppercase;
    color: #707070;
}

.meta-value { font-size: 13dp; }

.sidebar {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    width: 232dp;
    padding: 8dp;
    box-sizing: border-box;
    background-color: #1c1c1c;
    border-right: 1dp #2f2f2f;
}

.inspector {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    width: 440dp;
    box-sizing: border-box;
    background-color: #222222;
    border-left: 1dp #2f2f2f;
}

.main { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }

.split { display: flex; height: 100%; }

virtual-grid { display: block; }

.grid-header { display: flex; align-items: flex-end; padding-bottom: 10dp; box-sizing: border-box; }

.grid-header .group-header { flex: 1 1 auto; }

.grid-row { display: flex; gap: 12dp; align-items: flex-start; padding-bottom: 12dp; }

.grid-item { flex: 1 1 0; }

.grid-filler { flex: 0 1 0; }

.group-header {
    display: flex;
    align-items: center;
    gap: 8dp;
    height: 32dp;
}

.group-toggle { flex: 1 1 auto; display: flex; align-items: center; gap: 8dp; height: 32dp; }

.group-toggle:hover .group-name { text-decoration: underline; }

.group-name { font-size: 14dp; font-weight: bold; }

.group-count { font-family: Google Sans Code; font-size: 11dp; color: #707070; }

.group-action { margin-left: auto; font-size: 13dp; color: #ffffff; }

.content-list {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1dp #2f2f2f;
    border-radius: 4dp;
    background-color: #1c1c1c;
}

.content-row {
    display: flex;
    align-items: center;
    gap: 12dp;
    height: 52dp;
    padding: 0 16dp;
}

/*! RmlUi keeps a data-for element as a hidden last child, so :last-child never matches the last shown row. */
.content-row + .content-row, .content-slot + .content-slot .content-row { border-top: 1dp #2f2f2f; }

.content-row.muted > * { opacity: 0.4; }

.content-row.locked { height: 36dp; }

.content-row.locked input, .content-row.locked .content-icon { opacity: 0.5; }

.content-row.locked .content-title { color: #707070; }

.content-text { flex: 1 1 0; display: flex; flex-direction: column; gap: 1dp; }

.content-icon { flex: 0 0 auto; width: 16dp; height: 16dp; image-color: #ffffff; }

.content-title { font-size: 13dp; font-weight: bold; }

.content-detail { font-size: 12dp; font-weight: normal; color: #707070; }

.content-meta { font-family: Google Sans Code; font-size: 11dp; color: #b3b3b3; }

.options { display: flex; align-items: flex-start; gap: 12dp; }

.option-card {
    flex: 1 1 0;
    display: flex;
    align-items: flex-start;
    gap: 12dp;
    padding: 12dp 14dp;
    border: 1dp #2f2f2f;
    border-radius: 4dp;
    background-color: #222222;
}

.option-card:hover { border-color: #4a4a4a; }

.option-card.selected { background-color: #2b2b2b; border-color: #ffffff; }

.option-icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32dp;
    height: 32dp;
    border-radius: 4dp;
    background-color: #161616;
}

.option-icon svg { image-color: #ffffff; }

.option-text { flex: 1 1 0; display: flex; flex-direction: column; gap: 3dp; }

.option-title { font-size: 13dp; font-weight: bold; }

.option-detail { font-size: 12dp; color: #707070; }

.option-stack { display: flex; flex-direction: column; gap: 8dp; }

.option-stack .option-card { flex: 0 0 auto; }

.step { display: flex; align-items: center; gap: 10dp; }

.step-index {
    width: 24dp;
    height: 24dp;
    box-sizing: border-box;
    border: 1dp #4a4a4a;
    border-radius: 12dp;
    background-color: #161616;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 0.4dp;
    line-height: 22dp;
    text-align: center;
    color: #707070;
}

.step-index.current { background-color: #f2f2f2; border-color: #f2f2f2; color: #111111; }

.step-index.done {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #38d39f24;
    border-color: #38d39f24;
}

.step-title { font-size: 13dp; font-weight: bold; }

.step-detail { font-size: 12dp; color: #707070; }

.step.pending .step-title { color: #707070; }

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8dp;
    padding: 32dp;
    text-align: center;
}

.empty-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48dp;
    height: 48dp;
    border-radius: 24dp;
    background-color: #2b2b2b;
}

.empty-title { font-size: 14dp; font-weight: bold; }

.empty-message { width: 320dp; max-width: 100%; font-size: 13dp; font-weight: normal; color: #707070; }

.menu {
    display: flex;
    flex-direction: column;
    padding: 4dp;
    border: 1dp #4a4a4a;
    border-radius: 6dp;
    background-color: #2b2b2b;
    box-shadow: #00000099 0 8dp 24dp 0;
}

.menu-item {
    display: flex;
    align-items: center;
    gap: 10dp;
    height: 30dp;
    padding: 0 8dp;
    border-radius: 4dp;
    font-size: 13dp;
}

.menu-item:hover { background-color: #353535; }

.menu-item.danger { color: #ff4655; }

.menu-item.danger svg { image-color: #ff4655; }

.menu-item.disabled { color: #707070; }

.menu-item.disabled svg { image-color: #707070; }

.menu-item.disabled:hover { background-color: transparent; }

.menu-chevron { margin-left: auto; }

.menu-separator { height: 1dp; margin: 4dp 0; background-color: #4a4a4a; }

.toast {
    display: flex;
    align-items: flex-start;
    gap: 10dp;
    width: 360dp;
    padding: 12dp;
    box-sizing: border-box;
    border-left: 3dp #38d39f;
    border-radius: 4dp;
    background-color: #2b2b2b;
    box-shadow: #00000099 0 8dp 24dp 0;
}

.toast.warning { border-left-color: #f5c242; }

.toast.danger { border-left-color: #ff4655; }

.toast.info { border-left-color: #2ca7f6; }

.toast-text { flex: 1 1 0; display: flex; flex-direction: column; gap: 2dp; }

.toast-title { font-size: 13dp; font-weight: bold; }

.toast-message { font-size: 12dp; font-weight: normal; color: #b3b3b3; }

.toast-action {
    margin-top: 6dp;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 0.4dp;
    text-transform: uppercase;
}

.banner {
    display: flex;
    align-items: center;
    gap: 12dp;
    padding: 10dp 12dp;
    border: 1dp #f5c24266;
    border-radius: 4dp;
    background-color: #f5c24224;
}

.banner.info { border-color: #2ca7f64d; background-color: #2ca7f61f; }

.banner-text { flex: 1 1 0; display: flex; flex-direction: column; gap: 2dp; }

.banner-title { font-size: 13dp; font-weight: bold; }

.banner-message { font-size: 12dp; font-weight: normal; color: #b3b3b3; }

.video-badge {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 4dp;
    padding: 2dp 6dp 2dp 4dp;
    border-radius: 2dp;
    background-color: #0000009e;
    font-family: Google Sans Code;
    font-size: 11dp;
}

.chips {
    display: flex;
    gap: 2dp;
    padding: 3dp;
    border-radius: 4dp;
    background-color: #161616;
}

.chips.locked { opacity: 0.45; }

.chip {
    display: block;
    padding: 3dp 8dp;
    border-radius: 2dp;
    font-size: 11dp;
    font-weight: bold;
    letter-spacing: 0.66dp;
    text-transform: uppercase;
    color: #b3b3b3;
}

.chip:hover { background-color: #353535; }

.chip.on { background-color: #ffffff; color: #111111; }

.section-head { display: flex; align-items: center; gap: 6dp; height: 14dp; }

.section-head .caps { flex: 1 1 0; }

.section-action { font-size: 12dp; color: #b3b3b3; }

.section-action:hover { color: #ffffff; }

.section-value { font-family: Google Sans Code; font-size: 11dp; color: #707070; }

.section-value.secondary { color: #b3b3b3; }

.section { display: flex; flex-direction: column; gap: 8dp; }

.note { display: flex; align-items: center; gap: 6dp; font-size: 12dp; color: #707070; }

.note svg { flex: 0 0 auto; width: 12dp; height: 12dp; image-color: #707070; }

.note p { flex: 1 1 0; }

.video-controls {
    position: absolute;
    z-index: 1;
    left: 0;
    bottom: 0;
    width: 100%;
    box-sizing: border-box;
    display: none;
    align-items: center;
    gap: 10dp;
    padding: 14dp 12dp 8dp 12dp;
    decorator: linear-gradient(180deg, #00000000 0%, #000000b3 100%);
}

video.loaded:hover .video-controls, video.loaded.paused .video-controls { display: flex; }

.video-controls .video-toggle, .video-controls .video-mute, .video-controls .video-maximize { flex: 0 0 auto; display: flex; width: 16dp; height: 16dp; }

.video-controls .video-toggle svg, .video-controls .video-mute svg, .video-controls .video-maximize svg { width: 16dp; height: 16dp; image-color: #ffffff; }

.video-mute .video-muted-icon { display: none; }

video.muted .video-mute .video-muted-icon { display: block; }

video.muted .video-mute .video-volume-icon { display: none; }

.video-maximize .video-minimize-icon { display: none; }

video.maximized .video-maximize .video-minimize-icon { display: block; }

video.maximized .video-maximize .video-maximize-icon { display: none; }

video.maximized { z-index: 1000; clip: none; background-color: #000000; }

.video-toggle .video-play-icon { display: none; }

video.paused .video-toggle .video-play-icon { display: block; }

video.paused .video-toggle .video-pause-icon { display: none; }

.video-seek, .video-volume { display: flex; align-items: center; height: 14dp; drag: drag; }

.video-seek { flex: 1 1 auto; }

.video-volume { flex: 0 0 56dp; }

.video-seek-line, .video-volume-line { flex: 1 1 auto; height: 3dp; border-radius: 2dp; background-color: #ffffff47; }

.video-seek-fill, .video-volume-fill { width: 0; height: 3dp; border-radius: 2dp; background-color: #ffffff; }

.video-clock { flex: 0 0 auto; font-family: Google Sans Code; font-size: 11dp; color: #e6e6e6; }

.video-play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border: 1.5dp #ffffff;
    background-color: #0000009e;
}

.video-play svg { image-color: #ffffff; }

.video-play.large { width: 60dp; height: 60dp; margin: -30dp 0 0 -30dp; border-radius: 30dp; }

.video-play.large svg { width: 24dp; height: 24dp; }

.video-play.small { width: 44dp; height: 44dp; margin: -22dp 0 0 -22dp; border-radius: 22dp; }

.video-play.small svg { width: 18dp; height: 18dp; }

.video-source {
    display: flex;
    align-items: center;
    gap: 6dp;
    padding: 3dp 8dp;
    border-radius: 2dp;
    background-color: #0000009e;
    font-size: 11dp;
    letter-spacing: 0.66dp;
    text-transform: uppercase;
    white-space: nowrap;
}

.video-source.large { padding: 5dp 8dp; border-radius: 4dp; }

.tooltip {
    display: flex;
    align-items: center;
    gap: 6dp;
    padding: 5dp 8dp;
    border: 1dp #4a4a4a;
    border-radius: 4dp;
    background-color: #2b2b2b;
    font-size: 12dp;
    white-space: nowrap;
}

.export-button {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6dp;
    height: 32dp;
    padding: 0 12dp;
    border-radius: 4dp;
    background-color: #f2f2f2;
    font-size: 13dp;
    color: #111111;
    white-space: nowrap;
}

.export-button svg, .export-button img, .export-button spinner { image-color: #111111; }

.export-button:hover { background-color: #ffffff; }

.export-button.disabled { opacity: 0.4; }

.export-button.disabled:hover { background-color: #f2f2f2; }

.export-count { font-family: Google Sans Code; font-size: 11dp; color: #707070; }

.export-button.grow { flex: 1 1 0; min-width: 0; }

.table {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1dp #2f2f2f;
    border-radius: 4dp;
    background-color: #222222;
}

.table-head {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    height: 32dp;
    padding: 0 8dp;
    box-sizing: border-box;
    border-bottom: 1dp #2f2f2f;
    background-color: #1c1c1c;
}

.table-head span {
    font-size: 11dp;
    letter-spacing: 0.66dp;
    text-transform: uppercase;
    color: #707070;
}

.table-body { flex: 1 1 0; min-height: 0; overflow-y: auto; }

.filters { flex: 0 0 auto; display: flex; align-items: center; gap: 8dp; }

.filters-end { margin-left: auto; display: flex; align-items: center; gap: 8dp; }

.push-end { margin-left: auto; }

.tooltip.floating {
    display: none;
    position: fixed;
    z-index: 10000;
    pointer-events: none;
    color: #ffffff;
}

.tooltip.floating.shown { display: flex; }

.inspector-back {
    flex: 0 0 auto;
    display: none;
    align-items: center;
    height: 44dp;
    padding: 0 8dp;
    border-bottom: 1dp #2f2f2f;
}

/*! <splitter>: a thin handle between two panels; "vertical" sits between columns, "horizontal" between rows. */
splitter { display: block; flex: 0 0 auto; drag: drag; }

splitter.vertical { width: 6dp; margin: 0 -2dp; cursor: ew-resize; }

splitter.horizontal { height: 6dp; margin: -2dp 0; cursor: ns-resize; }

splitter:hover, splitter:active { background-color: #ffffff14; }
