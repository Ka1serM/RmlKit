{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}"
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "description": "llvm-mingw: Clang, libc++ and LLD for Windows. Its bin folder is in PATH.",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "AMD64",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-clang++"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "description": "Clang with libc++ and LLD.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "web",
      "hidden": true,
      "inherits": "base",
      "description": "Emscripten for a browser. The first configure installs it into RmlKit's emsdk submodule.",
      "cacheVariables": {
        "PLATFORM": "Web"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "inherits": [
        "windows",
        "debug"
      ]
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "inherits": [
        "windows",
        "release"
      ]
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": [
        "linux",
        "debug"
      ]
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": [
        "linux",
        "release"
      ]
    },
    {
      "name": "web-debug",
      "displayName": "Web Debug",
      "inherits": [
        "web",
        "debug"
      ]
    },
    {
      "name": "web-release",
      "displayName": "Web Release",
      "inherits": [
        "web",
        "release"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "web-debug",
      "configurePreset": "web-debug"
    },
    {
      "name": "web-release",
      "configurePreset": "web-release"
    }
  ]
}
