<rml>
<head>
    <title>Main</title>
    <link type="text/rcss" href="../RmlKit/Styles/base.rcss"/>
    <link type="text/rcss" href="../RmlKit/Styles/components.rcss"/>
    <link type="text/rcss" href="../RmlKit/Styles/window.rcss"/>
    <link type="text/rcss" href="../RmlKit/Styles/window-buttons.rcss"/>
    <link type="text/rcss" href="../Styles/theme.rcss"/>
    <link type="text/rcss" href="../Styles/example.rcss"/>
    <link type="text/rcss" href="../Platform/WindowButtons/style.rcss"/>
</head>
<!--! The router opens this document with the data model "app" and shows the views of UI/Views inside #views. -->
<body id="main" data-model="app">
    <header class="title-bar">
        <div class="window-drag-region"></div>
        <div class="window-buttons start" data-if="windowButtons &amp;&amp; windowButtonsStart.size &gt; 0" data-class-windows="windowButtonStyle == 'windows'" data-class-gnome="windowButtonStyle == 'gnome'" data-class-kde="windowButtonStyle == 'kde'" data-class-macos="windowButtonStyle == 'macos'" data-class-gtk="windowButtonStyle == 'gtk'" data-class-unfocused="!windowFocused" data-class-maximized="windowMaximized">
            <button class="title-button" data-for="button : windowButtonsStart" data-class-close="button == 'close'" data-class-minimize="button == 'minimize'" data-class-maximize="button == 'maximize'" data-event-click="windowButton(button)"><svg data-attr-src="'/UI/RmlKit/Icons/window-' + (windowButtonStyle == 'gtk' ? 'gnome' : windowButtonStyle) + '-' + (button == 'maximize' &amp;&amp; windowMaximized ? 'restore' : button) + '.svg'"/></button>
        </div>
        <div class="title-left">
            <svg class="wordmark example-mark" src="../../assets/icon.svg"/>
            <span class="title-card">{{ productName }}</span>
            <div class="breadcrumb">
                <span class="crumb-separator">/</span>
                <span class="crumb current">{{ navigation.crumb }}</span>
            </div>
        </div>
        <div class="title-right">
            <div class="window-buttons end" data-if="windowButtons &amp;&amp; windowButtonsEnd.size &gt; 0" data-class-windows="windowButtonStyle == 'windows'" data-class-gnome="windowButtonStyle == 'gnome'" data-class-kde="windowButtonStyle == 'kde'" data-class-macos="windowButtonStyle == 'macos'" data-class-gtk="windowButtonStyle == 'gtk'" data-class-unfocused="!windowFocused" data-class-maximized="windowMaximized">
                <button class="title-button" data-for="button : windowButtonsEnd" data-class-close="button == 'close'" data-class-minimize="button == 'minimize'" data-class-maximize="button == 'maximize'" data-event-click="windowButton(button)"><svg data-attr-src="'/UI/RmlKit/Icons/window-' + (windowButtonStyle == 'gtk' ? 'gnome' : windowButtonStyle) + '-' + (button == 'maximize' &amp;&amp; windowMaximized ? 'restore' : button) + '.svg'"/></button>
            </div>
        </div>
    </header>

    <div class="app-body maximize-area">
        <nav class="nav-rail">
            <button class="nav-item" nav="home" tooltip="Home" data-event-click="showView('home')">
                <div class="nav-indicator"></div>
                <svg class="icon-20" src="../../assets/icons/icon-house.svg"/>
                <span>Home</span>
            </button>
            <div class="nav-spacer"></div>
            <button class="nav-item" nav="about" tooltip="About" data-event-click="showView('about')">
                <div class="nav-indicator"></div>
                <svg class="icon-20" src="../../assets/icons/icon-info.svg"/>
                <span>About</span>
            </button>
        </nav>
        <main class="content" id="views"></main>
    </div>

    <footer class="status-bar">
        <div class="status-left">
            <div class="status-item">
                <div class="status-dot online"></div>
                <span class="status-name">{{ demo.platform }}</span>
            </div>
            <div class="status-item" data-if="logs.warningCount + logs.errorCount > 0">
                <span class="status-mono">{{ logs.warningCount }} warnings, {{ logs.errorCount }} errors</span>
            </div>
        </div>
        <div class="status-right">
            <div class="status-item" data-if="demo.working">
                <spinner class="icon-12 icon-info"/>
                <span class="status-name">Working</span>
                <div class="progress status-progress"><div class="progress-fill info" data-style-width="demo.percent + '%'"></div></div>
            </div>
        </div>
    </footer>
    <div id="tooltip" class="tooltip floating"></div>
</body>
</rml>
