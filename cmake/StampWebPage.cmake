#! Runs after the web link: writes the download size into the page and versions index.js, so a browser does not mix two builds.
file(SIZE "${OUTPUT_DIR}/index.wasm" wasm_size)
file(SIZE "${OUTPUT_DIR}/index.data" data_size)
math(EXPR download_size "${wasm_size} + ${data_size}")
set(hashes "")
foreach(file index.js index.wasm index.data)
    file(SHA256 "${OUTPUT_DIR}/${file}" hash)
    string(APPEND hashes "${hash}")
endforeach()
string(SHA256 version "${hashes}")
string(SUBSTRING "${version}" 0 16 version)
file(READ "${OUTPUT_DIR}/index.html" page)
string(REPLACE "__RMLKIT_DOWNLOAD_SIZE__" "${download_size}" page "${page}")
string(REPLACE "__RMLKIT_BUILD_VERSION__" "${version}" page "${page}")
string(REGEX MATCH "src=\"?index\\.js\"?" script_source "${page}")
if(NOT script_source)
    message(FATAL_ERROR "${OUTPUT_DIR}/index.html has no script tag for index.js")
endif()
string(REPLACE "${script_source}" "src=\"index.js?v=${version}\"" page "${page}")
file(WRITE "${OUTPUT_DIR}/index.html" "${page}")
