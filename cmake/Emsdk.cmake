#! The web build includes this before project(): it installs the pinned Emscripten into external/emsdk and takes its toolchain file.
set(emsdk_version 6.0.13)
cmake_path(SET rmlkit_dir NORMALIZE "${CMAKE_CURRENT_LIST_DIR}/..")
set(EMSDK_ROOT "${rmlkit_dir}/external/emsdk")
if(NOT EXISTS "${EMSDK_ROOT}/emsdk.py")
    find_package(Git REQUIRED)
    message(STATUS "Checking out the emsdk submodule")
    execute_process(COMMAND "${GIT_EXECUTABLE}" submodule update --init external/emsdk
        WORKING_DIRECTORY "${rmlkit_dir}" RESULT_VARIABLE emsdk_result)
    if(NOT emsdk_result EQUAL 0 OR NOT EXISTS "${EMSDK_ROOT}/emsdk.py")
        message(FATAL_ERROR "The checkout of RmlKit/external/emsdk failed. Run in RmlKit: git submodule update --init external/emsdk")
    endif()
endif()

set(emsdk_version_file "${EMSDK_ROOT}/upstream/emscripten/emscripten-version.txt")
set(installed_version "")
if(EXISTS "${emsdk_version_file}")
    file(READ "${emsdk_version_file}" installed_version)
    string(STRIP "${installed_version}" installed_version)
    string(REPLACE "\"" "" installed_version "${installed_version}")
endif()
if(NOT installed_version STREQUAL emsdk_version OR NOT EXISTS "${EMSDK_ROOT}/.emscripten")
    if(CMAKE_HOST_WIN32)
        set(emsdk_command "${EMSDK_ROOT}/emsdk.bat")
    else()
        set(emsdk_command "${EMSDK_ROOT}/emsdk")
    endif()
    foreach(step install activate)
        message(STATUS "emsdk ${step} ${emsdk_version}")
        execute_process(COMMAND "${emsdk_command}" ${step} ${emsdk_version} WORKING_DIRECTORY "${EMSDK_ROOT}"
            RESULT_VARIABLE emsdk_result)
        if(NOT emsdk_result EQUAL 0)
            message(FATAL_ERROR "emsdk ${step} ${emsdk_version} failed with ${emsdk_result}.")
        endif()
    endforeach()
endif()

#! emcc finds its tools through the .emscripten file that EM_CONFIG names.
set(ENV{EM_CONFIG} "${EMSDK_ROOT}/.emscripten")
set(CMAKE_TOOLCHAIN_FILE "${EMSDK_ROOT}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake")
