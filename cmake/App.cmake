#! The app includes this in its top-level CMakeLists.txt after project(), next to its own options. A web build includes Emsdk.cmake before project().
include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/EmbeddedResources.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../external/NoorRHI/cmake/NoorRHIShaders.cmake")
cmake_path(SET RMLKIT_DIR NORMALIZE "${CMAKE_CURRENT_LIST_DIR}/..")

if(EMSCRIPTEN)
    if(NOT DEFINED EMSDK_ROOT)
        message(FATAL_ERROR "A web build includes RmlKit/cmake/Emsdk.cmake before project().")
    endif()
    #! emcc finds its tools through EM_CONFIG, which the configure step set only for itself.
    set(emscripten_launcher "\"${CMAKE_COMMAND}\" -E env \"EM_CONFIG=${EMSDK_ROOT}/.emscripten\" \"EMSDK=${EMSDK_ROOT}\"")
    set_property(GLOBAL PROPERTY RULE_LAUNCH_COMPILE "${emscripten_launcher}")
    set_property(GLOBAL PROPERTY RULE_LAUNCH_LINK "${emscripten_launcher}")
endif()

#! Makes the executable `target` an RmlKit app on every platform; README.md lists the arguments.
function(rmlkit_add_app target)
    cmake_parse_arguments(PARSE_ARGV 1 APP "" "APPLICATION;APPLICATION_HEADER;UI_DIR;ASSET_DIR;ICON;TOUCH_ICON;DESKTOP_COMMENT;DESKTOP_CATEGORIES;WEB_PRE_JS;WEB_LIBRARY_JS" "RESOURCES;DEPENDS")
    if(APP_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "rmlkit_add_app: unknown arguments ${APP_UNPARSED_ARGUMENTS}")
    endif()
    foreach(required APPLICATION APPLICATION_HEADER UI_DIR)
        if(NOT APP_${required})
            message(FATAL_ERROR "rmlkit_add_app: ${required} is required")
        endif()
    endforeach()
    target_sources(${target} PRIVATE "${RMLKIT_DIR}/src/RmlKit/UI/Main.cpp")
    target_compile_definitions(${target} PRIVATE "RMLKIT_APPLICATION_CLASS=${APP_APPLICATION}"
        "RMLKIT_APPLICATION_HEADER=\"${APP_APPLICATION_HEADER}\"")
    file(GLOB_RECURSE ui_files CONFIGURE_DEPENDS "${APP_UI_DIR}/UI/*.rml" "${APP_UI_DIR}/UI/*.rcss")
    set(resources ROOT "${APP_UI_DIR}" ${ui_files})
    if(APP_ASSET_DIR)
        file(GLOB_RECURSE asset_files CONFIGURE_DEPENDS "${APP_ASSET_DIR}/assets/*")
        list(APPEND resources ROOT "${APP_ASSET_DIR}" ${asset_files})
    endif()
    list(APPEND resources ${APP_RESOURCES})

    #! The toolchain decides the platform, so an app need not set the PLATFORM_ variables before it calls this.
    if(EMSCRIPTEN)
        set(platform Web)
    elseif(WIN32)
        set(platform Windows)
    else()
        set(platform Linux)
    endif()

    if(APP_ICON)
        cmake_path(GET APP_ICON EXTENSION LAST_ONLY icon_extension)
        if(NOT icon_extension MATCHES "^\\.(svg|png)$")
            message(FATAL_ERROR "rmlkit_add_app: the ICON ${APP_ICON} is not an .svg or a .png")
        endif()
    endif()

    if(platform STREQUAL "Linux" AND APP_ICON)
        if(NOT RMLKIT_APP_ID)
            message(FATAL_ERROR "rmlkit_add_app: the Linux launcher needs RMLKIT_APP_ID")
        endif()
        set(desktop "${CMAKE_CURRENT_BINARY_DIR}/${target}_desktop")
        set(RMLKIT_DESKTOP_NAME "${CMAKE_PROJECT_NAME}")
        set(RMLKIT_DESKTOP_COMMENT "${APP_DESKTOP_COMMENT}")
        set(RMLKIT_DESKTOP_CATEGORIES "${APP_DESKTOP_CATEGORIES}")
        configure_file("${RMLKIT_DIR}/cmake/launcher.desktop.in" "${desktop}/RmlKit/Desktop/launcher.desktop" @ONLY)
        configure_file("${APP_ICON}" "${desktop}/RmlKit/Desktop/icon${icon_extension}" COPYONLY)
        list(APPEND resources ROOT "${desktop}" "${desktop}/RmlKit/Desktop/launcher.desktop" "${desktop}/RmlKit/Desktop/icon${icon_extension}")
    endif()

    if(NOT platform STREQUAL "Web")
        rmlkit_add_resources(${target}_resources ${resources})
        if(APP_DEPENDS)
            add_dependencies(${target}_resources ${APP_DEPENDS})
        endif()
        if(platform STREQUAL "Windows")
            set_target_properties(${target} PROPERTIES WIN32_EXECUTABLE TRUE)
            target_link_options(${target} PRIVATE "$<$<CONFIG:Release>:-s>")
        else()
            target_link_options(${target} PRIVATE -static-libstdc++ -static-libgcc "$<$<CONFIG:Release>:-s>")
        endif()
        return()
    endif()

    set(RMLKIT_TITLE "${CMAKE_PROJECT_NAME}")
    set(RMLKIT_ICON_LINKS "")
    if(icon_extension STREQUAL ".svg")
        set(RMLKIT_ICON_LINKS "<link rel=\"icon\" href=\"favicon.svg\" type=\"image/svg+xml\">")
    elseif(icon_extension STREQUAL ".png")
        set(RMLKIT_ICON_LINKS "<link rel=\"icon\" href=\"favicon.png\" type=\"image/png\">")
    endif()
    if(APP_TOUCH_ICON)
        string(APPEND RMLKIT_ICON_LINKS "\n<link rel=\"apple-touch-icon\" href=\"apple-touch-icon.png\">")
    endif()
    set(shell "${CMAKE_CURRENT_BINARY_DIR}/${target}_shell.html")
    configure_file("${RMLKIT_DIR}/web/shell.html" "${shell}" @ONLY)

    #! Each file is preloaded on its own: a folder such as UI/ also holds the app's sources.
    set(preloads "--preload-file=${RMLKIT_UI_DIR}/UI/RmlKit@UI/RmlKit")
    set(preloaded "")
    foreach(argument IN LISTS resources)
        if(argument STREQUAL "ROOT")
            set(expect_root TRUE)
        elseif(expect_root)
            set(root "${argument}")
            set(expect_root FALSE)
        else()
            file(RELATIVE_PATH path "${root}" "${argument}")
            list(APPEND preloads "--preload-file=${argument}@${path}")
            list(APPEND preloaded "${argument}")
        endif()
    endforeach()

    set(link_depends "${shell}" ${preloaded})
    if(APP_WEB_PRE_JS)
        list(APPEND link_depends "${APP_WEB_PRE_JS}")
        target_link_options(${target} PRIVATE "--pre-js=${APP_WEB_PRE_JS}")
    endif()
    if(APP_WEB_LIBRARY_JS)
        list(APPEND link_depends "${APP_WEB_LIBRARY_JS}")
        target_link_options(${target} PRIVATE "--js-library=${APP_WEB_LIBRARY_JS}")
    endif()
    list(JOIN link_depends ";" link_depends)
    set_target_properties(${target} PROPERTIES SUFFIX ".html" OUTPUT_NAME "index" LINK_DEPENDS "${link_depends}")
    if(APP_DEPENDS)
        add_dependencies(${target} ${APP_DEPENDS})
    endif()
    target_link_options(${target} PRIVATE
        -sWASMFS
        -sMAXIMUM_MEMORY=4GB -sMALLOC=mimalloc
        -sPTHREAD_POOL_SIZE=navigator.hardwareConcurrency -sEXIT_RUNTIME=0
        -sEXPORTED_RUNTIME_METHODS=ccall,callMain
        "--shell-file=${shell}" ${preloads})
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND "${CMAKE_COMMAND}" "-DOUTPUT_DIR=$<TARGET_FILE_DIR:${target}>" -P "${RMLKIT_DIR}/cmake/StampWebPage.cmake")
    if(APP_ICON)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E copy "${APP_ICON}" "$<TARGET_FILE_DIR:${target}>/favicon${icon_extension}")
    endif()
    if(APP_TOUCH_ICON)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E copy "${APP_TOUCH_ICON}" "$<TARGET_FILE_DIR:${target}>/apple-touch-icon.png")
    endif()
endfunction()
